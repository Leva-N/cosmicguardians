# Discord OAuth2
# Создайте приложение на https://discord.com/developers/applications
# Redirect URI для локальной разработки: http://localhost:3000/api/auth/discord/callback
# Redirect URI для Vercel: https://your-project.vercel.app/api/auth/discord/callback
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# X (Twitter) OAuth 2.0
# Создайте приложение на https://developer.x.com
# Redirect URI: http://localhost:3000/api/auth/x/callback (и ваш production URL)
# Включите OAuth 2.0 в настройках приложения
X_CLIENT_ID=SmRzYnVhMlRTUTllUlRyMXpSYnU6MTpjaQ
X_CLIENT_SECRET=mCUxk_n5mavOcy2BIFcwmTz3NMeJXWGBZsPL6eMvZxDMDQyfYt

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Redis (Vercel KV / Upstash) — для хранения постов транслятора в production
# Подключите Redis в Vercel Dashboard → Storage → Create Database → KV
# Переменные KV_REST_API_URL и KV_REST_API_TOKEN добавляются автоматически
